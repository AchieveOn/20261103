# .env.example — 雛形（値は入れない）。cp .env.example .env して .env に本物の値を書く。
# .env は .gitignore 済み。Render では Dashboard の Environment に同じキーを登録する。

# Flask のセッション署名用。生成: python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=

# Neon の接続文字列（アプリ用ロール app_rw）。sslmode=require を必ず付ける
DATABASE_URL=postgresql://app_rw:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/appdb?sslmode=require

# テスト用 Neon ブランチ（test）。未設定なら DB テストはスキップされる
TEST_DATABASE_URL=

# 個人情報などの列を暗号化する鍵（Fernet）。生成: .venv/bin/python -c "from app.crypto import generate_key; print(generate_key())"
APP_ENCRYPTION_KEY=

# ---- バックアップ（Render Cron Job 側で使う） ----
# 読み取り専用ロール backup_ro の接続文字列
BACKUP_DATABASE_URL=
# バックアップファイルを暗号化する鍵（APP_ENCRYPTION_KEY とは別の鍵にする）
BACKUP_ENCRYPTION_KEY=
# Gmail 送信（2段階認証 + アプリパスワード）
GMAIL_USER=
GMAIL_APP_PASSWORD=
BACKUP_MAIL_TO=
